# Copy to .env and fill in your values:  cp .env.example .env
# .env is gitignored — your handle never gets committed.

# Your Chess.com account name (used by scraper.py and analyze.py)
CHESS_USERNAME=your_chesscom_handle

# Where games and engine analyses are stored (one SQLite file)
CHESS_DB=data/chess.db

# Output path for the generated HTML report
REPORT_FILE=report.html

# Path to a UCI engine for game-review mode.
# Easiest on macOS:  brew install stockfish  ->  /opt/homebrew/bin/stockfish
# Leave blank to auto-detect `stockfish` on PATH.
STOCKFISH_PATH=/opt/homebrew/bin/stockfish

# Search depth for engine analysis (higher = slower, more accurate)
ENGINE_DEPTH=15

# Depth for batch-analysing recent games in the player report (faster)
RECENT_DEPTH=12

# Parallel Stockfish processes for the rating-corpus pass (Peers / Brackets).
# The engine's NNUE is a shared mapping, so extra processes cost well under
# 100 MB each; 3 keeps an 8 GB laptop usable.
CORPUS_WORKERS=3

# Eval threshold (centipawns) for the "conversion" stat (200 = +/-2.00)
DECISIVE_CP=200
