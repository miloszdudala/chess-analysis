# Copy to .env and fill in your values:  cp .env.example .env
# .env is gitignored — your handle never gets committed.

# Your Chess.com account name (used by scraper.py and analyze.py)
CHESS_USERNAME=your_chesscom_handle

# Where downloaded PGNs are stored
GAMES_DIR=games

# Output path for the generated HTML report
REPORT_FILE=report.html
