#!/bin/bash
# Start chess-analysis and open it in the browser — no terminal needed.
#
#   bin/chess-analysis          start (restarting any old server) and open
#   bin/chess-analysis --stop   stop the server
#
# Double-clicking "Chess Analysis" in the Dock/Applications runs this. Each
# launch restarts the server, so edits to the code are always picked up.
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PORT="${PORT:-5050}"
URL="http://127.0.0.1:$PORT"
PY="$ROOT/.venv/bin/python"
LOG="$ROOT/data/webapp.log"

# No terminal when launched from the Dock, so failures go to a dialog instead.
die() {
    if [ -t 2 ]; then
        printf '%s\n' "$1" >&2
    else
        osascript -e "display alert \"Chess Analysis\" message \"$1\" as critical" >/dev/null 2>&1
    fi
    exit 1
}

# Stop whatever is serving this app on $PORT — and only that: a PID is killed
# only once its command line confirms it is our webapp.py.
stop_server() {
    local killed=0 pid
    for pid in $(lsof -ti "tcp:$PORT" -sTCP:LISTEN 2>/dev/null); do
        case "$(ps -o command= -p "$pid" 2>/dev/null)" in
            *webapp.py*) kill "$pid" 2>/dev/null && killed=1 ;;
        esac
    done
    [ "$killed" = 1 ] && sleep 1
    return 0
}

if [ "${1:-}" = "--stop" ]; then
    stop_server
    echo "Stopped."
    exit 0
fi

[ -x "$PY" ] || die "No virtualenv at .venv — run: python3 -m venv .venv && .venv/bin/pip install -r requirements.txt"

cd "$ROOT" || die "Cannot open $ROOT"
stop_server

mkdir -p "$(dirname "$LOG")"
: > "$LOG"
PORT="$PORT" nohup "$PY" "$ROOT/webapp.py" >>"$LOG" 2>&1 &

# Wait for the port to actually answer before opening the browser, so the tab
# never lands on "can't connect".
for _ in $(seq 1 60); do
    if curl -fsS -o /dev/null --max-time 1 "$URL/api/config" 2>/dev/null; then
        open "$URL"
        exit 0
    fi
    sleep 0.5
done

die "Server did not start. Last lines of data/webapp.log:

$(tail -n 12 "$LOG" | sed 's/"/\\"/g')"
