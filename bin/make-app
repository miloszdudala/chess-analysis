#!/bin/bash
# Build "Chess Analysis.app" — a Dock launcher for this project — into
# ~/Applications. The bundle holds only an icon and a shim that execs
# bin/chess-analysis, so the real logic stays here in the repo.
#
#   bin/make-app
#
# Re-run after moving the project: the shim hard-codes this folder's path.
set -eu

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APP="$HOME/Applications/Chess Analysis.app"
BUILD="$(mktemp -d)"
trap 'rm -rf "$BUILD"' EXIT

command -v iconutil >/dev/null || { echo "needs macOS (iconutil)" >&2; exit 1; }

# --- icon ---------------------------------------------------------------
python3 "$ROOT/bin/appicon.py" "$BUILD/icon_1024.png" >/dev/null
mkdir "$BUILD/icon.iconset"
while read -r size name; do
    [ -n "$size" ] || continue
    sips -z "$size" "$size" "$BUILD/icon_1024.png" \
         --out "$BUILD/icon.iconset/$name.png" >/dev/null
done <<'SIZES'
16 icon_16x16
32 icon_16x16@2x
32 icon_32x32
64 icon_32x32@2x
128 icon_128x128
256 icon_128x128@2x
256 icon_256x256
512 icon_256x256@2x
512 icon_512x512
1024 icon_512x512@2x
SIZES
iconutil -c icns "$BUILD/icon.iconset" -o "$BUILD/AppIcon.icns"

# --- bundle -------------------------------------------------------------
rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
cp "$BUILD/AppIcon.icns" "$APP/Contents/Resources/AppIcon.icns"

# NS*UsageDescription is what lets macOS prompt for access to the project
# folder; without it the app is denied silently and never asks.
cat > "$APP/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>              <string>Chess Analysis</string>
    <key>CFBundleDisplayName</key>       <string>Chess Analysis</string>
    <key>CFBundleIdentifier</key>        <string>local.chessanalysis.launcher</string>
    <key>CFBundleVersion</key>           <string>1.0</string>
    <key>CFBundleShortVersionString</key><string>1.0</string>
    <key>CFBundlePackageType</key>       <string>APPL</string>
    <key>CFBundleExecutable</key>        <string>ChessAnalysis</string>
    <key>CFBundleIconFile</key>          <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>    <string>11.0</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>Chess Analysis starts the local report server from your project folder in Documents.</string>
    <key>NSDesktopFolderUsageDescription</key>
    <string>Chess Analysis starts the local report server from your project folder.</string>
</dict>
</plist>
PLIST

cat > "$APP/Contents/MacOS/ChessAnalysis" <<EOF
#!/bin/bash
# Thin shim: the logic lives in the repo so it stays version-controlled.
# Reading the launcher is also what triggers the one-time macOS prompt for
# access to Documents; without that permission the repo is unreadable to us.
LAUNCHER="$ROOT/bin/chess-analysis"

if ! head -c 1 "\$LAUNCHER" >/dev/null 2>&1; then
    osascript -e 'display alert "Chess Analysis needs file access" message "macOS is blocking this app from reading the project in your Documents folder.

Open System Settings > Privacy & Security > Files and Folders (or Full Disk Access) and enable Chess Analysis, then launch it again." as critical' >/dev/null 2>&1
    open "x-apple.systempreferences:com.apple.preference.security?Privacy_FilesAndFolders" >/dev/null 2>&1
    exit 1
fi

exec "\$LAUNCHER"
EOF
chmod +x "$APP/Contents/MacOS/ChessAnalysis"

plutil -lint "$APP/Contents/Info.plist" >/dev/null
# Apple silicon refuses to launch a wholly unsigned bundle; ad-hoc is enough.
codesign --force --deep -s - "$APP"
touch "$APP"

echo "Built: $APP"
echo "Launch it once and click Allow when macOS asks for Documents access."
